{
  "expo": {
    "name": "Boat Timer",
    "slug": "gig-timer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",

    "icon": "./assets/icon.png",

    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "assetBundlePatterns": [
      "**/*"
    ],

    "android": {
      "package": "com.yourname.gigtimer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },

    "ios": {
      "bundleIdentifier": "com.yourname.gigtimer",
      "supportsTablet": true,
      "buildNumber": "1.0.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "abiFilters": ["arm64-v8a", "armeabi-v7a"]
          }
        }
      ]
      /* Add file-system & splash-screen plugins here if needed later */
    ],

    "runtimeVersion": {
      "policy": "sdkVersion"
    },

    "extra": {
      "eas": {
        "projectId": "8ed0c8dd-d48b-4799-861d-9b40624f0f27"
      }
    }
  }
}
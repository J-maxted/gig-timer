{
  "expo": {
    "name": "Gig Timer",
    "slug": "gig-timer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "enabled": false
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.gigtimer",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yourname.gigtimer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": ["READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"],
      "intentFilters": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Gig Timer",
      "shortName": "GigTimer",
      "description": "Timer app for boat heats and results",
      "startUrl": ".",
      "backgroundColor": "#ffffff",
      "themeColor": "#6200ee",
      "display": "standalone",
      "icons": [
        {
          "src": "./assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        },
        {
          "src": "./assets/icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ]
    },
    "extra": {
      "eas": {
        "projectId": "8ed0c8dd-d48b-4799-861d-9b40624f0f27"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "abiFilters": ["arm64-v8a", "armeabi-v7a"]
          }
        }
      ],
      "expo-sharing"
    ]
  }
}
